<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Nice Launcher — Graphite & Ice palette.
         All UI text flows through these colors via the primaryColor
         theme attrs, so this single file retints day + night themes. -->
    <color name="colorPrimary">@android:color/white</color>
    <color name="colorPrimaryDark">@android:color/darker_gray</color>
    <color name="colorAccent">#FF22D3EE</color>

    <!--Ice white (night-mode text, day-mode inverse surfaces)-->
    <color name="white">#F4F8FB</color>
    <color name="whiteTrans90">#E6F4F8FB</color>
    <color name="whiteTrans80">#CCF4F8FB</color>
    <color name="whiteTrans50">#80F4F8FB</color>
    <color name="whiteInverse">#10131A</color>
    <color name="whiteInverseTrans10">#1A10131A</color>
    <color name="whiteInverseTrans25">#4010131A</color>
    <color name="whiteInverseTrans50">#8010131A</color>
    <color name="whiteInverseTrans80">#CC10131A</color>
    <color name="whiteInverseTrans90">#E610131A</color>

    <!--Graphite (day-mode text, night-mode inverse surfaces)-->
    <color name="black">#15181E</color>
    <color name="blackTrans90">#E615181E</color>
    <color name="blackTrans80">#CC15181E</color>
    <color name="blackTrans50">#8015181E</color>
    <color name="blackInverse">#F4F8FB</color>
    <color name="blackInverseTrans10">#1AF4F8FB</color>
    <color name="blackInverseTrans25">#40F4F8FB</color>
    <color name="blackInverseTrans50">#80F4F8FB</color>
    <color name="blackInverseTrans80">#CCF4F8FB</color>
    <color name="blackInverseTrans90">#E6F4F8FB</color>

</resources>